@page
@model AttendanceDashboard.Pages.HistoryModel
@{
    ViewData["Title"] = "Lịch sử";
    ViewData["Page"] = "History";
}

<h4 class="fw-bold mb-4">Lịch sử điểm danh</h4>

<div class="card p-3 mb-4">
    <form method="get">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">UID sinh viên</label>
                <input name="uid" class="form-control" placeholder="VD: A001"
                       value="@Model.FilterUID" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Từ ngày</label>
                <input name="from" type="date" class="form-control"
                       value="@Model.FilterFrom" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Đến ngày</label>
                <input name="to" type="date" class="form-control"
                       value="@Model.FilterTo" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i> Tìm kiếm
                </button>
            </div>
        </div>
    </form>
</div>

<div class="card p-3">
    <div class="text-muted mb-3">Tìm thấy: <strong>@Model.Records.Count</strong> bản ghi</div>
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Mã SV</th>
                <th>UID</th>
                <th>Họ tên</th>
                <th>Lớp</th>
                <th>Ngày</th>
                <th>Giờ vào</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Records.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        Không có dữ liệu
                    </td>
                </tr>
            }
            @for (int i = 0; i < Model.Records.Count; i++)
            {
                var r = Model.Records[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td><span class="badge bg-primary">@r.StudentCode</span></td>
                    <td><span class="badge bg-secondary">@r.UID</span></td>
                    <td>@r.FullName</td>
                    <td>@r.ClassName</td>
                    <td>@r.CheckInTime.ToString("dd/MM/yyyy")</td>
                    <td>@r.CheckInTime.ToString("HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@model IEnumerable<WebQLBH.Models.CTBanHang>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DonBanHang.MaDBH)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SanPham.TenSP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SLB)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DGB)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.DonBanHang.MaDBH)
            </td>
            <td>
                @Html.DisplayFor(model => item.SanPham.TenSP)
            </td>
            <td>
                @Html.DisplayFor(model => item.SLB)
            </td>
            <td>
                @Html.DisplayFor(model => item.DGB)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { madbh = @item.MaDBH, masp = @item.MaSP }) |
                @Html.ActionLink("Details", "Details", new { madbh = @item.MaDBH, masp = @item.MaSP }) |
                @Html.ActionLink("Delete", "Delete", new { madbh = @item.MaDBH, masp = @item.MaSP })
            </td>
        </tr>
}
    </tbody>
</table>

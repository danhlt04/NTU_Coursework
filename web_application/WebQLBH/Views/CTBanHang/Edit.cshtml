@model WebQLBH.Models.CTBanHang

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>CTBanHang</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="madbh" value="@Model.MaDBH" />
            <input type="hidden" name="masp" value="@Model.MaSP" />

            <div class="form-group">
                <label>Ma don ban hang</label>
                <select asp-for="MaDBH" asp-items="ViewBag.DonBanHangs"></select>
            </div>

            <div class="form-group">
                <label>Ten san pham</label>
                <select asp-for="MaSP" asp-items="ViewBag.SanPhams"></select>
            </div>

            <div class="form-group">
                <label asp-for="SLB" class="control-label"></label>
                <input asp-for="SLB" class="form-control" />
                <span asp-validation-for="SLB" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DGB" class="control-label"></label>
                <input asp-for="DGB" class="form-control" />
                <span asp-validation-for="DGB" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

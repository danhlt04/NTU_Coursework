@model WebQLBH.Models.CTBanHang

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>CTBanHang</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label>Đơn bán hàng</label>
                <select asp-for="MaDBH" asp-items="ViewBag.DonBanHangs">
                    <option value="">-- Chọn đơn bán hàng --</option>
                </select>
            </div>

            <div class="form-group">
                <label>Sản phẩm</label>
                <select asp-for="MaSP" asp-items="ViewBag.SanPhams">
                    <option value="">-- Chọn sản phẩm --</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="SLB" class="control-label"></label>
                <input asp-for="SLB" class="form-control" />
                <span asp-validation-for="SLB" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DGB" class="control-label"></label>
                <input asp-for="DGB" class="form-control" />
                <span asp-validation-for="DGB" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

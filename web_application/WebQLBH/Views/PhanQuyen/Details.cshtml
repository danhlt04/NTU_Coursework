@model WebQLBH.Models.PhanQuyen

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Tên quyền</dt>
        <dd class="col-sm-9">@Model.Quyen?.TenQuyen</dd>

        <dt class="col-sm-3">Tên nhân viên</dt>
        <dd class="col-sm-9">@Model.NhanVien?.TenNV</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-maquyen="@Model.MaQuyen"
       asp-route-manv="@Model.MaNV">
        Edit
    </a> |
    <a asp-action="Index">Back to List</a>
</div>
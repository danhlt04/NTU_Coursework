@model WebQLBH.Models.PhanQuyen

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>PhanQuyen</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="MaQuyenCu" value="@Model.MaQuyen" />
            <input type="hidden" name="MaNVCu" value="@Model.MaNV" />

            <div class="form-group">
                <label>Quyền</label>
                <select asp-for="MaQuyen" asp-items="ViewBag.Quyens">
                </select>
            </div>
            
            <div class="form-group">
                <label>Nhân viên</label>
                <select asp-for="MaNV" asp-items="ViewBag.NhanViens">

                </select>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
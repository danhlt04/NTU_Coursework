@model WebQLBH.Models.SanPham

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Sản phẩm</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaSP" />
            <div class="form-group">
                <label asp-for="TenSP" class="control-label">Tên sản phẩm</label>
                <input asp-for="TenSP" class="form-control" />
                <span asp-validation-for="TenSP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DonGia" class="control-label">Đơn giá</label>
                <input asp-for="DonGia" class="form-control" />
                <span asp-validation-for="DonGia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AnhSP" class="control-label">Ảnh sản phẩm</label>
                <input asp-for="AnhSP" class="form-control" />
                <span asp-validation-for="AnhSP" class="text-danger"></span>
                @* <label asp-for="TenDN" class="control-label"></label>
                <input asp-for="TenDN" class="form-control" />
                <span asp-validation-for="TenDN" class="text-danger"></span> *@
            </div>
            <div class="form-group">
                <p>
                    Ảnh hiện tại:
                    @if (!string.IsNullOrEmpty(Model.AnhSP))
                    {
                        <img src="~/images/uploads/@Model.AnhSP" width="80" />
                    }
                </p>
                <input type="hidden" name="existingAnh" value="@Model.AnhSP" />
                <label>Chọn ảnh mới (nếu muốn)</label>
                <input type="file" name="image" />
            </div>
            <div class="form-group">
                <label asp-for="MoTaTT" class="control-label">Mô tả tóm tắt</label>
                <input asp-for="MoTaTT" class="form-control" />
                <span asp-validation-for="MoTaTT" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThongTinCT" class="control-label">Thông tin chi tiết</label>
                <input asp-for="ThongTinCT" class="form-control" />
                <span asp-validation-for="ThongTinCT" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Thuộc loại sản phẩm</label>
                <select asp-for="MaLSP" asp-items="ViewBag.LoaiSanPhams"></select>
            </div>
            <div class="form-group">
                <label>Thuộc đơn vị tính</label>
                <select asp-for="MaDVT" asp-items="ViewBag.DonViTinhs"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

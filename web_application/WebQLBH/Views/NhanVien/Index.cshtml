@model IEnumerable<WebQLBH.Models.NhanVien>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MaNV)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HoNV)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TenNV)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DienThoai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TenDN)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AnhNV)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PB.TenPB)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.MaNV)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HoNV)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TenNV)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DienThoai)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TenDN)
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.AnhNV))//Nếu có ảnh nhân viên
                    {
                        <img src="~/images/uploads/@item.AnhNV" alt="" width="80" />
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PB.TenPB)
                </td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { manv = @item.MaNV })|
                    @Html.ActionLink("Chi tiết", "Details", new { manv = @item.MaNV })|
                    @Html.ActionLink("Xóa", "Delete", new { manv = @item.MaNV })
                </td>
            </tr>
        }
    </tbody>
</table>

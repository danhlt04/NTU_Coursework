@model IEnumerable<WebQLBH.Models.DonViTinh>

@{
    ViewData["Title"] = "Index";
}

<h1>Đơn vị tính</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MaDVT)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TenDVT)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaDVT)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenDVT)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new {madvt = item.MaDVT}) |
                @Html.ActionLink("Details", "Details", new { madvt = item.MaDVT }) |
                @Html.ActionLink("Delete", "Delete", new { madvt = item.MaDVT }) 
            </td>
        </tr>
}
    </tbody>
</table>

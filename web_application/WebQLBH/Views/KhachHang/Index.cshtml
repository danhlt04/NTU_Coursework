@model IEnumerable<WebQLBH.Models.KhachHang>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HoKH)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TenKH)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DienThoai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiaChi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.XaPhuong.TenXP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TenDN)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.HoKH)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenKH)
            </td>
            <td>
                @Html.DisplayFor(model => item.DienThoai)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.DiaChi)
            </td>
            <td>
                @Html.DisplayFor(model => item.XaPhuong.TenXP)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenDN)
            </td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { makh = @item.MaKH })|
                @Html.ActionLink("Chi tiết", "Details", new { makh = @item.MaKH })|
                @Html.ActionLink("Xóa", "Delete", new { makh = @item.MaKH })
            </td>
        </tr>
}
    </tbody>
</table>

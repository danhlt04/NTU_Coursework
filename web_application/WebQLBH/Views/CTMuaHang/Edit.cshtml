@model WebQLBH.Models.CTMuaHang

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>CTMuaHang</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="madmh" value="@Model.MaDMH" />
            <input type="hidden" name="masp" value="@Model.MaSP" />

            <div class="form-group">
                <label>Mã đơn mua hàng</label>
                <select asp-for="MaDMH" asp-items="ViewBag.DonMuaHangs">
                </select>
            </div>

            <div class="form-group">
                <label>Tên sản phẩm</label>
                <select asp-for="MaSP" asp-items="ViewBag.SanPhams">
                </select>
            </div>

            <div class="form-group">
                <label asp-for="SLM" class="control-label"></label>
                <input asp-for="SLM" class="form-control" />
                <span asp-validation-for="SLM" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DGM" class="control-label"></label>
                <input asp-for="DGM" class="form-control" />
                <span asp-validation-for="DGM" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
